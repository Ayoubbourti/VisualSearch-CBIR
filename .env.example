# Copier ce fichier vers .env : il est chargé automatiquement au démarrage (python-dotenv).
# Les variables déjà définies dans le terminal restent prioritaires.

# development | production | testing
APP_ENV=development

# OBLIGATOIRE en production (≥ 32 caractères). Générer :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# Emplacement de la base SQLite et du stockage des images
GALLERY_DB=webapp/instance/gallery.db
GALLERY_STORAGE=webapp/instance/storage

# API de descripteurs
DESCRIPTOR_API_URL=http://127.0.0.1:5001
DESCRIPTOR_API_KEY=            # vide = API ouverte (développement local uniquement)
API_PORT=5001
API_TIMEOUT=300
API_MAX_FILES=64

# Limite d'envoi (octets) : 512 Mo
MAX_CONTENT_LENGTH=536870912

# Production derrière HTTPS : cookies « Secure » + HSTS (mettre false pour tester en HTTP local)
SESSION_COOKIE_SECURE=true
ENABLE_HSTS=true
LOG_LEVEL=INFO
